[
  {
    "bindings": {
      "alt-[": "pane::ActivatePreviousItem",
      "alt-]": "pane::ActivateNextItem",
      "ctrl-shift-left": "pane::ActivatePreviousItem",
      "ctrl-shift-right": "pane::ActivateNextItem"
    }
  },
  {
    "context": "Editor && edit_prediction && edit_prediction_mode == eager && !showing_completions",
    "bindings": {
      "tab": null,
      "alt-right": "editor::AcceptEditPrediction",
      "alt-l": "editor::AcceptEditPrediction"
    }
  },
  {
    "context": "Editor && VimControl",
    "bindings": {
      "j": ["vim::Down", { "display_lines": true }],
      "down": ["vim::Down", { "display_lines": true }],
      "k": ["vim::Up", { "display_lines": true }],
      "up": ["vim::Up", { "display_lines": true }],
      "; d": ["workspace::SendKeystrokes", "\" _ d"],
      "; c": ["workspace::SendKeystrokes", "\" _ c"],
      "; x": ["workspace::SendKeystrokes", "\" _ x"],
      "s a": ["vim::PushAddSurrounds", {}],
      "s d": "vim::PushDeleteSurrounds",
      "s r": ["vim::PushChangeSurrounds", {}],
      "space f": "editor::Format"
    }
  }
]
