{
  "proxy": "",
  "autosave": "on_focus_change",
  "ui_font_family": "Inter",
  "buffer_font_family": "Annotation Mono",
  "buffer_font_features": {
    "liga": true,
    "ss01": true,
    "onum": true
  },
  "buffer_font_size": 16.0,
  "buffer_font_fallbacks": ["Symbols Nerd Font Mono"],
  "preferred_line_length": 120,
  "soft_wrap": "bounded",
  "theme": "Gruvbox Dark Hard",
  "icon_theme": "Zed (Default)",
  "vim_mode": true,
  "cursor_animation": {
    "enabled": true
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "right",
    "button": false
  },
  "show_call_status_icon": false,
  "restore_on_startup": "launchpad",
  "default_open_behavior": "new_window",
  "cli_default_open_behavior": "new_window",
  "session": {
    "restore_unsaved_buffers": false
  },
  "suggest_extensions": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "agent": {
    "tool_permissions": {
      "default": "allow",
      "tools": {}
    },
    "default_model": {
      "provider": "opencode",
      "model": "go/deepseek-v4.1-flash",
      "enable_thinking": true,
      "effort": "low"
    },
    "dock": "right",
    "enable_feedback": false
  },
  "edit_predictions": {
    "provider": "copilot"
  }
}
