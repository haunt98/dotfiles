{
  "autosave": "on_focus_change",
  "ui_font_family": "MonoLisaText",
  "buffer_font_family": "MonoLisaCode",
  "buffer_font_features": {
    "liga": true,
    "calt": true,
    "dlig": true,
    "ss02": true
  },
  "buffer_font_size": 16.0,
  "buffer_font_fallbacks": ["Symbols Nerd Font Mono"],
  "preferred_line_length": 120,
  "soft_wrap": "bounded",
  "theme": "Gruvbox Light",
  "icon_theme": "Zed (Default)",
  "vim_mode": true,
  "cursor_animation": {
    "enabled": true
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "right",
    "button": false
  },
  "show_call_status_icon": false,
  "restore_on_startup": "launchpad",
  "default_open_behavior": "new_window",
  "cli_default_open_behavior": "new_window",
  "session": {
    "restore_unsaved_buffers": false
  },
  "suggest_extensions": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "agent": {
    "dock": "right",
    "enable_feedback": false
  },
  "edit_predictions": {
    "provider": "copilot"
  }
}
